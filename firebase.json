{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9888
    },
    "functions": {
      "port": 5555
    },
    "firestore": {
      "port": 8888
    },
    "database": {
      "port": 9777
    },
    "storage": {
      "port": 9666
    },
    "ui": {
      "enabled": true,
      "port": 4444
    },
    "singleProjectMode": true
  }
}
