{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5556,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8181,
      "host": "127.0.0.1"
    },
    "database": {
      "port": 9100,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9299,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "port": 4100,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true
  }
}
