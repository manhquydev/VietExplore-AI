{
  "version": 2,
  "regions": ["sin1"],
  "_comment_crons": "MIGRATED TO FIREBASE CLOUD SCHEDULER - See functions/src/index.ts",
  "_crons_deprecated": [
    {
      "_note": "Replaced by: scheduledCleanupExpiredClaims (Firebase)",
      "path": "/api/cron/cleanup-expired-claims",
      "schedule": "0 */2 * * *"
    },
    {
      "_note": "Replaced by: scheduledArchiveModerationQueue (Firebase)",
      "path": "/api/cron/archive-moderation-queue",
      "schedule": "0 2 * * *"
    },
    {
      "_note": "Replaced by: scheduledModerationHealthCheck (Firebase)",
      "path": "/api/cron/moderation-health-check",
      "schedule": "0 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/places/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/places/validate",
      "destination": "/api/edge/validate-place"
    },
    {
      "source": "/api/auth/verify",
      "destination": "/api/edge/auth/verify"
    },
    {
      "source": "/api/moderation/claim",
      "destination": "/api/edge/moderation/claim"
    }
  ]
}