{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "dev:emulator": "concurrently \"firebase emulators:start --only auth,firestore,functions,storage,database\" \"npm run dev\"",
    "dev:complete": "node scripts/dev-complete.js",
    "dev:production": "cross-env NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false npm run dev",
    "dev:local": "npm run dev:emulator",
    "build": "next build",
    "build:production": "cross-env NODE_ENV=production npm run build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "emulator": "firebase emulators:start --only auth,firestore,functions,storage,database",
    "emulator:ui": "firebase emulators:start --only auth,firestore,functions,storage,database,ui",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:functions": "cd functions && npm test",
    "functions:build": "cd functions && npm run build",
    "functions:deploy": "firebase deploy --only functions",
    "deploy": "npm run build:production && firebase deploy",
    "deploy:hosting": "npm run build:production && firebase deploy --only hosting",
    "deploy:functions": "npm run functions:build && firebase deploy --only functions",
    "analyze": "cross-env ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output-path=./lighthouse-report.html --save-assets --view",
    "sitemap:tree": "node scripts/generate-sitemap-tree.js",
    "sitemap:tree:file": "node scripts/generate-sitemap-tree.js --file",
    "sitemap:file": "node scripts/generate-sitemap-file.js",
    "sitemap:routes": "tree /F /A src\\app",
    "deploy:backend": "node scripts/deploy-backend.js",
    "setup:admin": "node scripts/setup-admin.js",
    "setup:admin:local": "node scripts/setup-admin-local.js",
    "setup:admin:guide": "node scripts/setup-admin-simple.js",
    "setup:admin:manual": "node scripts/manual-admin-setup.js",
    "fix:admin:password": "node scripts/fix-admin-password.js",
    "test:accounts": "node scripts/setup-test-accounts-local.js",
    "test:accounts:cleanup": "node scripts/cleanup-test-accounts-local.js"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.14.1",
    "@genkit-ai/next": "^1.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "genkit": "^1.14.1",
    "lucide-react": "^0.475.0",
    "next": "15.3.3",
    "next-sitemap": "^4.2.3",
    "patch-package": "^8.0.0",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.0",
    "genkit-cli": "^1.14.1",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.1",
    "typescript": "^5"
  }
}
