rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isModerator() {
      return getUserRole() in ['moderator', 'admin'];
    }
    
    function isContributorOrAbove() {
      // Get role from custom claims instead of Firestore
      return request.auth.token.role != null && 
             request.auth.token.role in ['contributor', 'partner', 'moderator', 'admin'];
    }

    // User profile images
    match /users/{userId}/profile/{imageId} {
      allow read: if true; // Public read for profile images
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Place images without userId - only contributors and above can upload
    match /places/images/{imageId} {
      allow read: if true; // Public read for place images
      allow write: if isSignedIn() && isContributorOrAbove();
    }
    
    // Place images - only contributors and above can upload
    match /places/images/{userId}/{imageId} {
      allow read: if true; // Public read for place images
      allow write: if isSignedIn() && (isOwner(userId) || isContributorOrAbove());
    }
    
    // Place videos without userId - only contributors and above can upload
    match /places/videos/{videoId} {
      allow read: if true; // Public read for place videos
      allow write: if isSignedIn() && isContributorOrAbove();
    }
    
    // Place videos - only contributors and above can upload
    match /places/videos/{userId}/{videoId} {
      allow read: if true; // Public read for place videos
      allow write: if isSignedIn() && (isOwner(userId) || isContributorOrAbove());
    }
    
    // Legacy place images path for backwards compatibility
    match /places/{placeId}/images/{imageId} {
      allow read: if true; // Public read for place images
      allow write: if isSignedIn() && isContributorOrAbove();
    }
    
    // Legacy place videos path for backwards compatibility
    match /places/{placeId}/videos/{videoId} {
      allow read: if true; // Public read for place videos
      allow write: if isSignedIn() && isContributorOrAbove();
    }

    // Itinerary images
    match /itineraries/{itineraryId}/images/{imageId} {
      allow read: if true; // Public read
      allow write: if isSignedIn(); // Any authenticated user can upload itinerary images
    }

    // Announcement images - only moderators and admins can upload
    match /announcements/images/{imageId} {
      allow read: if true; // Public read for announcement images
      allow write: if isSignedIn() && isModerator();
    }

    // Announcement images with userId - only moderators and admins can upload
    match /announcements/images/{userId}/{imageId} {
      allow read: if true; // Public read for announcement images
      allow write: if isSignedIn() && (isOwner(userId) || isModerator());
    }

    // Admin uploads
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Temporary uploads (24h TTL)
    match /temp/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
