# -----------------------------------------------------------------------------
# Firebase Client Configuration (Publicly accessible)
# These are used by the frontend to connect to Firebase services.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"

# Optional: Set to 'true' to connect to local Firebase Emulators during development
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Optional: reCAPTCHA v3 key for App Check in production
NEXT_PUBLIC_FIREBASE_APP_CHECK_KEY="your-recaptcha-v3-site-key"


# -----------------------------------------------------------------------------
# Firebase Server Configuration (Keep these secret)
# These are used by the backend (API routes) for admin-level access.
# -----------------------------------------------------------------------------

# Paste the entire content of your Firebase service account JSON key here.
# IMPORTANT: This variable should be a single-line string. In some shells or
# hosting providers, you may need to escape special characters or base64 encode it.
FIREBASE_ADMIN_SDK_JSON='{"type": "service_account", "project_id": "...", ...}'


# -----------------------------------------------------------------------------
# Cron Job Security
# A secret key to prevent unauthorized execution of your cron job endpoints.
# -----------------------------------------------------------------------------
CRON_SECRET="generate-a-strong-random-string-here"
