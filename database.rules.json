{
  "rules": {
    // Places stats - publicly readable, allow writes for view tracking (both client and server)
    "places": {
      "$placeId": {
        "stats": {
          ".read": true,
          ".write": true
        }
      }
    },
    
    // User interactions - users can read/write their own data
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid || auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())",
        ".write": "$userId === auth.uid",
        "interactions": {
          ".read": "$userId === auth.uid",
          ".write": "$userId === auth.uid"
        },
        "recent_interactions": {
          ".read": "$userId === auth.uid || auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())",
          ".write": "$userId === auth.uid"
        }
      }
    },
    
    // Admin/moderator lists - only they can read/write
    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    
    "moderators": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    
    // Analytics data - admins only
    "analytics": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    
    // Admin moderation stats - allow authenticated users to read/write for now
    "admin": {
      "moderation": {
        "reports_stats": {
          ".read": "auth != null",
          ".write": true
        }
      },
      // Admin places data - simplified permissions for authenticated users with admin claims
      "places": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },
    
    // Real-time notifications - users can read their own, admins can read all
    "notifications": {
      "$userId": {
        ".read": "$userId === auth.uid || auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    
    // User presence tracking - users can update their own presence, all authenticated users can read
    "user_presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid"
      }
    },
    
    // Active users tracking - authenticated users can update their own status
    "active_users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid"
      }
    },
    
    // User stats (unread notifications count) - users can read/write their own
    "user_stats": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid || auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    
    // Moderator alerts - only moderators and admins can read/write
    "moderator_alerts": {
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())"
      }
    },
    
    // Moderation queue updates - moderators and admins only
    "moderation_queue_updates": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())"
    },
    
    // User activity tracking - users can write their own activity
    "user_activity": {
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "$userId === auth.uid"
      }
    },
    
    // Audit logs - admins only can read/write, authenticated users can create logs
    "audit_logs": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')"
    },
    
    // Audit stats - admins only
    "audit_stats": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    }
  }
}