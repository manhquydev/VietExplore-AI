{
  "rules": {
    // Places stats - publicly readable, allow writes for view tracking
    "places": {
      "$placeId": {
        "stats": {
          ".read": true,
          ".write": true,
          ".indexOn": ["status", "region", "type"]
        }
      }
    },

    // User interactions and stats
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid || auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
        ".write": "$userId === auth.uid",
        "interactions": {
          ".read": "$userId === auth.uid",
          ".write": "$userId === auth.uid"
        },
        "recent_interactions": {
          ".read": "$userId === auth.uid || auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
          ".write": "$userId === auth.uid"
        },
        "stats": {
          ".read": "$userId === auth.uid || auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
          ".write": false
        }
      }
    },

    // Admin/moderator lists
    "admins": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    "moderators": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // Admin consolidated section
    "admin": {
      "moderation": {
        "reports_stats": {
          ".read": "auth != null",
          ".write": true
        },
        "stats": {
          ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
          ".write": false
        }
      },
      "places": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "auth != null && auth.token.role === 'admin'"
      },
      "dashboard": {
        "stats": {
          ".read": "auth != null && auth.token.role === 'admin'",
          ".write": false
        }
      }
    },

    // Analytics
    "analytics": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // Real-time notifications - users can read their own, admins/moderators can write
    "notifications": {
      "$userId": {
        ".read": "$userId === auth.uid || auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
        "$notificationId": {
          "read": {
            ".write": "$userId === auth.uid"
          }
        }
      }
    },

    // User presence tracking
    "user_presence": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid"
      }
    },

    // Active users tracking
    "active_users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid"
      }
    },

    // User stats
    "user_stats": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid || auth != null && auth.token.role === 'admin'"
      }
    },

    // Moderator alerts
    "moderator_alerts": {
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || auth.token.role === 'admin' || auth.token.role === 'moderator')",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')"
      }
    },

    // Moderation queue updates
    "moderation_queue_updates": {
      "$itemId": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
        ".write": false,
        ".indexOn": ["status", "priority", "createdAt"]
      }
    },

    // User activity tracking
    "user_activity": {
      "$userId": {
        ".read": "auth != null && ($userId === auth.uid || auth.token.role === 'admin')",
        ".write": "$userId === auth.uid"
      }
    },

    // Audit logs
    "audit_logs": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')"
    },

    // Audit stats
    "audit_stats": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // Admin dashboard
    "admin_dashboard": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'",
      "system_health": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "auth != null && auth.token.role === 'admin'"
      },
      "notifications": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },

    // System health
    "system_health": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // Moderation handoffs
    "moderation_handoffs": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')"
    },

    // Health check
    "health_check": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // Security monitoring
    "security_monitoring": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // System metrics
    "system_metrics": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    // Admin connections
    "admin_connections": {
      "$adminId": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "$adminId === auth.uid && auth != null && auth.token.role === 'admin'"
      }
    }
  }
}
