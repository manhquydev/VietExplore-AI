[debug] [2025-09-30T18:42:35.355Z] >>> [apiv2][body] PUT https://vietexplore-ai-default-rtdb.asia-southeast1.firebasedatabase.app/.settings/rules.json "{\r\n  \"rules\": {\r\n    // Places stats - publicly readable, allow writes for view tracking (both client and server)\r\n    \"places\": {\r\n      \"$placeId\": {\r\n        \"stats\": {\r\n          \".read\": true,\r\n          \".write\": true\r\n        }\r\n      }\r\n    },\r\n    \r\n    // User interactions - users can read/write their own data\r\n    \"users\": {\r\n      \"$userId\": {\r\n        \".read\": \"$userId === auth.uid || auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())\",\r\n        \".write\": \"$userId === auth.uid\",\r\n        \"interactions\": {\r\n          \".read\": \"$userId === auth.uid\",\r\n          \".write\": \"$userId === auth.uid\"\r\n        },\r\n        \"recent_interactions\": {\r\n          \".read\": \"$userId === auth.uid || auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())\",\r\n          \".write\": \"$userId === auth.uid\"\r\n        }\r\n      }\r\n    },\r\n    \r\n    // Admin/moderator lists - only they can read/write\r\n    \"admins\": {\r\n      \".read\": \"auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())\",\r\n      \".write\": \"auth != null && root.child('admins').child(auth.uid).exists()\"\r\n    },\r\n    \r\n    \"moderators\": {\r\n      \".read\": \"auth != null && (root.child('admins').child(auth.uid).exists() || root.child('moderators').child(auth.uid).exists())\",\r\n      \".write\": \"auth != null && root.child('admins').child(auth.uid).exists()\"\r\n    },\r\n    \r\n    // Analytics data - admins only\r\n    \"analytics\": {\r\n      \".read\": \"auth != null && root.child('admins').child(auth.uid).exists()\",\r\n      \".write\": \"auth != null && root.child('admins').child(auth.uid).exists()\"\r\n    },\r\n    \r\n    // Admin moderation stats - allow authenticated users to read/write for now\r\n    \"admin\": {\r\n      \"moderation\": {\r\n        \"reports_stats\": {\r\n          \".read\": \"auth != null\",\r\n          \".write\": true\r\n        }\r\n      },\r\n      // Admin places data - simplified permissions for authenticated users with admin claims\r\n      \"places\": {\r\n        \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n        \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n      }\r\n    },\r\n    \r\n    // Real-time notifications - users can read their own, admins/server can write\r\n    \"notifications\": {\r\n      \"$userId\": {\r\n        \".read\": \"$userId === auth.uid || auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        \".write\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        // Allow marking as read by the owner\r\n        \"$notificationId\": {\r\n          \"read\": {\r\n            \".write\": \"$userId === auth.uid\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \r\n    // User presence tracking - users can update their own presence, all authenticated users can read\r\n    \"user_presence\": {\r\n      \"$userId\": {\r\n        \".read\": \"auth != null\",\r\n        \".write\": \"$userId === auth.uid\"\r\n      }\r\n    },\r\n    \r\n    // Active users tracking - authenticated users can update their own status\r\n    \"active_users\": {\r\n      \"$userId\": {\r\n        \".read\": \"auth != null\",\r\n        \".write\": \"$userId === auth.uid\"\r\n      }\r\n    },\r\n    \r\n    // User stats (unread notifications count) - users can read/write their own\r\n    \"user_stats\": {\r\n      \"$userId\": {\r\n        \".read\": \"$userId === auth.uid\",\r\n        \".write\": \"$userId === auth.uid || auth != null && root.child('adm