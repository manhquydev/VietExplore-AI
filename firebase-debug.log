    },\r\n        \"stats\": {\r\n          \".read\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n          \".write\": false\r\n        }\r\n      },\r\n      \"places\": {\r\n        \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n        \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n      },\r\n      \"dashboard\": {\r\n        \"stats\": {\r\n          \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n          \".write\": false\r\n        }\r\n      }\r\n    },\r\n\r\n    // Analytics\r\n    \"analytics\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n    },\r\n\r\n    // Real-time notifications - users can read their own, admins/moderators can write\r\n    \"notifications\": {\r\n      \"$userId\": {\r\n        \".read\": \"$userId === auth.uid || auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        \".write\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        \"$notificationId\": {\r\n          \"read\": {\r\n            \".write\": \"$userId === auth.uid\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n\r\n    // User presence tracking\r\n    \"user_presence\": {\r\n      \"$userId\": {\r\n        \".read\": \"auth != null\",\r\n        \".write\": \"$userId === auth.uid\"\r\n      }\r\n    },\r\n\r\n    // Active users tracking\r\n    \"active_users\": {\r\n      \"$userId\": {\r\n        \".read\": \"auth != null\",\r\n        \".write\": \"$userId === auth.uid\"\r\n      }\r\n    },\r\n\r\n    // User stats\r\n    \"user_stats\": {\r\n      \"$userId\": {\r\n        \".read\": \"$userId === auth.uid\",\r\n        \".write\": \"$userId === auth.uid || auth != null && auth.token.role === 'admin'\"\r\n      }\r\n    },\r\n\r\n    // Moderator alerts\r\n    \"moderator_alerts\": {\r\n      \"$userId\": {\r\n        \".read\": \"auth != null && ($userId === auth.uid || auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        \".write\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\"\r\n      }\r\n    },\r\n\r\n    // Moderation queue updates\r\n    \"moderation_queue_updates\": {\r\n      \"$itemId\": {\r\n        \".read\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        \".write\": false,\r\n        \".indexOn\": [\"status\", \"priority\", \"createdAt\"]\r\n      }\r\n    },\r\n\r\n    // User activity tracking\r\n    \"user_activity\": {\r\n      \"$userId\": {\r\n        \".read\": \"auth != null && ($userId === auth.uid || auth.token.role === 'admin')\",\r\n        \".write\": \"$userId === auth.uid\"\r\n      }\r\n    },\r\n\r\n    // Audit logs\r\n    \"audit_logs\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\"\r\n    },\r\n\r\n    // Audit stats\r\n    \"audit_stats\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n    },\r\n\r\n    // Admin dashboard\r\n    \"admin_dashboard\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\",\r\n      \"system_health\": {\r\n        \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n        \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n      },\r\n      \"notifications\": {\r\n        \".read\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n        \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n      }\r\n    },\r\n\r\n    // System health\r\n    \"system_health\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n    },\r\n\r\n    // Moderation handoffs\r\n    \"moderation_handoffs\": {\r\n      \".read\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\",\r\n      \".write\": \"auth != null && (auth.token.role === 'admin' || auth.token.role === 'moderator')\"\r\n    },\r\n\r\n    // Health check\r\n    \"health_check\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n    },\r\n\r\n    // Security monitoring\r\n    \"security_monitoring\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n    },\r\n\r\n    // System metrics\r\n    \"system_metrics\": {\r\n      \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n      \".write\": \"auth != null && auth.token.role === 'admin'\"\r\n    },\r\n\r\n    // Admin connections\r\n    \"admin_connections\": {\r\n      \"$adminId\": {\r\n        \".read\": \"auth != null && auth.token.role === 'admin'\",\r\n        \".write\": \"$adminId === auth.uid && auth != null && auth.token.role === 'admin'\"\r\n      }\r\n    }\r\n  }\r\n}\r\n"
