[debug] [2025-10-01T13:27:42.580Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/vietexplore-ai/rulesets {"name":"projects/vietexplore-ai/rulesets/b30ccbea-8da1-4181-871a-68234347463c","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\r\n    // Helper functions\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n    \r\n    function isOwner(uid) {\r\n      return request.auth.uid == uid;\r\n    }\r\n    \r\n    function getUserRole() {\r\n      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;\r\n    }\r\n    \r\n    function isAdmin() {\r\n      return getUserRole() == 'admin';\r\n    }\r\n    \r\n    function isModerator() {\r\n      return getUserRole() in ['moderator', 'admin'];\r\n    }\r\n    \r\n    function isContributorOrAbove() {\r\n      // Get role from custom claims instead of Firestore\r\n      return request.auth.token.role != null && \r\n             request.auth.token.role in ['contributor', 'partner', 'moderator', 'admin'];\r\n    }\r\n\r\n    // User profile images\r\n    match /users/{userId}/profile/{imageId} {\r\n      allow read: if true; // Public read for profile images\r\n      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());\r\n    }\r\n\r\n    // Place images without userId - only contributors and above can upload\r\n    match /places/images/{imageId} {\r\n      allow read: if true; // Public read for place images\r\n      allow write: if isSignedIn() && isContributorOrAbove();\r\n    }\r\n    \r\n    // Place images - only contributors and above can upload\r\n    match /places/images/{userId}/{imageId} {\r\n      allow read: if true; // Public read for place images\r\n      allow write: if isSignedIn() && (isOwner(userId) || isContributorOrAbove());\r\n    }\r\n    \r\n    // Place videos without userId - only contributors and above can upload\r\n    match /places/videos/{videoId} {\r\n      allow read: if true; // Public read for place videos\r\n      allow write: if isSignedIn() && isContributorOrAbove();\r\n    }\r\n    \r\n    // Place videos - only contributors and above can upload\r\n    match /places/videos/{userId}/{videoId} {\r\n      allow read: if true; // Public read for place videos\r\n      allow write: if isSignedIn() && (isOwner(userId) || isContributorOrAbove());\r\n    }\r\n    \r\n    // Legacy place images path for backwards compatibility\r\n    match /places/{placeId}/images/{imageId} {\r\n      allow read: if true; // Public read for place images\r\n      allow write: if isSignedIn() && isContributorOrAbove();\r\n    }\r\n    \r\n    // Legacy place videos path for backwards compatibility\r\n    match /places/{placeId}/videos/{videoId} {\r\n      allow read: if true; // Public read for place videos\r\n      allow write: if isSignedIn() && isContributorOrAbove();\r\n    }\r\n\r\n    // Itinerary images\r\n    match /itineraries/{itineraryId}/images/{imageId} {\r\n      allow read: if true; // Public read\r\n      allow write: if isSignedIn(); // Any authenticated user can upload itinerary images\r\n    }\r\n\r\n    // Announcement images - only moderators and admins can upload\r\n    match /announcements/images/{imageId} {\r\n      allow read: if true; // Public read for announcement images\r\n      allow write: if isSignedIn() && isModerator();\r\n    }\r\n\r\n    // Announcement images with userId - only moderators and admins can upload\r\n    match /announcements/images/{userId}/{imageId} {\r\n      allow read: if true; // Public read for announcement images\r\n      allow write: if isSignedIn() && (isOwner(userId) || isModerator());\r\n    }\r\n\r\n    // Admin uploads\r\n    match /admin/{allPaths=**} {\r\n      allow read, write: if isAdmin();\r\n    }\r\n\r\n    // Temporary uploads (24h TTL)\r\n    match /temp/{allPaths=**} {\r\n      allow read, write: if isSignedIn();\r\n    }\r\n\r\n    // Default deny\r\n    match /{allPaths=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"storage.rules"}]},"createTime":"2025-10-01T13:27:42.299583Z","metadata":{"services":["firebase.storage"]}}
